# ── Public (sent to the browser) ──────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Server only ───────────────────────────────────────────────
# Postgres connection string. In production use the Supabase *transaction pooler*
# (port 6543). Locally `supabase start` prints it (port 54322).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Random string; Vercel Cron sends it as a Bearer token to /api/cron/finalize.
CRON_SECRET=change-me
# Random string used to hash IP addresses for rate limiting (never stored raw).
RATE_LIMIT_SALT=change-me
# Dev only: pretend today is this Riyadh date (ignored when NODE_ENV=production).
# QAFILA_FAKE_TODAY=2026-11-20
